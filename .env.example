# Copy to .env and edit. .env is git-ignored; never commit real keys.

# --- Local (default): Ollama ---------------------------------------------
FORGE_LLM_BASE_URL=http://localhost:11434/v1
FORGE_GENERATOR_MODEL=qwen2.5:7b
FORGE_JUDGE_MODEL=llama3.1:8b

# --- Hosted: Groq free tier (uncomment and set the key) ------------------
# FORGE_LLM_BASE_URL=https://api.groq.com/openai/v1
# FORGE_LLM_API_KEY=
# FORGE_GENERATOR_MODEL=qwen/qwen3-32b
# FORGE_JUDGE_MODEL=llama-3.1-8b-instant

# --- Limits ---------------------------------------------------------------
FORGE_MAX_TOKENS_PER_RUN=400000
FORGE_MAX_ITERATIONS=3
FORGE_MAX_CONCURRENCY=2
